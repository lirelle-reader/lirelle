<?xml version="1.0" encoding="utf-8"?>
<!-- Single-colour version for themed icons: the launcher tints it and keeps the alpha.
     The same book as ic_launcher_foreground: its pages, then its cover over them. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A launcher shows the 72dp in the middle of the grid, often under a round mask. The drawing
         (x 32.5..84.5, y 23.5..80.5 with its strokes) is centred there and scaled to 0.7, which
         keeps its furthest point 27dp from the centre, inside the 33dp every mask leaves. -->
    <group
        android:pivotX="58.5"
        android:pivotY="52"
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="-4.5"
        android:translateY="2">
        <path
            android:pathData="M39.5,73.5L64.2,65.5M39.5,73.5L73.5,48.8M39.5,73.5L52.4,55.7M39.5,73.5L51.2,37.4"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeWidth="4.6" />
        <path
            android:pathData="M36,27V77H81"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="7" />
    </group>
</vector>
