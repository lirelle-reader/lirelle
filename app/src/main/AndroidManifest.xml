<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To send what was read without a network as soon as there is one again. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LirelleApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lirelle"
        android:usesCleartextTraffic="true">
        <!--
            The whole interface is Compose, which follows the window by itself: a rotation, a
            resize, a fold or a keyboard does not make the activity again, which would reload the
            page of the reader. Night mode, the language, the density and the text size still do.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OIDC redirect. The BookOrbit server accepts no other redirect URI. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth2-callback"
                    android:scheme="bookorbit" />
            </intent-filter>
            <!--
                Audiobookshelf's return from its identity provider: Lirelle's own address when the server
                allows it, else the official app's, which every server allows unless its administrator removed
                it. Both data elements combine: lirelle://oauth and audiobookshelf://oauth. A filter cannot ask
                for no path (one with a path refuses a link without any), so the activity compares the whole
                address before the query (oidcRedirectOf).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lirelle" />
                <data android:scheme="audiobookshelf" />
                <data android:host="oauth" />
            </intent-filter>
        </activity>
    </application>
</manifest>
