<resources>
    <!-- Bars -->
    <string name="reader_search_book">Search in the book</string>
    <!-- The page holds no bookmark: the button adds one. -->
    <string name="reader_bookmark_add">Add bookmark</string>
    <!-- The page holds one or more bookmarks: the button removes them. -->
    <string name="reader_bookmark_remove">Remove bookmark</string>
