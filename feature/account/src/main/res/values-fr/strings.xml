    <!-- What a screen reader says of the button at the end of a profile's row. %1$s: the username, %2$s: the kind of server ("BookOrbit"). -->
    <string name="profiles_more_actions">Autres actions pour %1$s, %2$s</string>

    <!-- The confirmation of a removal. -->
    <string name="profiles_remove_title">Supprimer ce profil ?</string>
    <string name="profiles_remove_body">Ce profil sera déconnecté et tout ce que l\'appareil garde pour lui sera effacé. Rien ne change sur le serveur.</string>
    <!-- Of a profile that is not the current one: its server is not told, so nothing says that it is signed out. -->
    <string name="profiles_remove_body_sleeping">Tout ce que l\'appareil garde pour ce profil sera effacé. Rien ne change sur le serveur.</string>
    <!-- The same two, for a profile whose server gave the device a key (Komga's, Kavita's when the app made it): the key is revoked there, the profile current or not. -->
    <string name="profiles_remove_body_key">Ce profil sera déconnecté et tout ce que l\'appareil garde pour lui sera effacé. Sa clé sera révoquée sur le serveur.</string>
    <string name="profiles_remove_body_sleeping_key">Tout ce que l\'appareil garde pour ce profil sera effacé. Sa clé sera révoquée sur le serveur.</string>
    <!-- For a profile signed in with a key the user pasted (Kavita's), current or not: the app only forgets the key, nothing is revoked. -->
    <string name="profiles_remove_body_own_key">Tout ce que l\'appareil garde pour ce profil sera effacé. La clé que vous avez fournie reste valable sur le serveur.</string>
    <string name="profiles_remove_cancel">Annuler</string>
    <string name="profiles_remove_confirm">Supprimer</string>
    <!-- Of a profile that is not the current one: it is not opened to be counted. -->
    <string name="profiles_remove_sleeping">Ses téléchargements et ce qui n\'a pas encore été envoyé seront effacés avec lui.</string>
    <plurals name="profiles_remove_downloads">
        <item quantity="one">%1$d livre téléchargé (%2$s) sera supprimé de l\'appareil.</item>
        <item quantity="many">%1$d livres téléchargés (%2$s) seront supprimés de l\'appareil.</item>
        <item quantity="other">%1$d livres téléchargés (%2$s) seront supprimés de l\'appareil.</item>
    </plurals>
    <!-- The list comes last: the sentence then agrees whatever is in it. -->
    <plurals name="profiles_remove_pending">
        <item quantity="one">Un changement n\'a pas encore été envoyé au serveur et sera perdu : %1$s.</item>
        <item quantity="many">Des changements n\'ont pas encore été envoyés au serveur et seront perdus : %1$s.</item>
        <item quantity="other">Des changements n\'ont pas encore été envoyés au serveur et seront perdus : %1$s.</item>
    </plurals>
    <plurals name="account_pending_positions">
