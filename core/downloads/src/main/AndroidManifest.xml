<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Downloads the user asked for go on, without a time limit, once the app is left. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- The job is kept across a restart of the device. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The job waits for the network the downloads may use. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <service
            android:name=".job.DownloadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Cancel, on the notification of a download. -->
        <receiver
            android:name=".job.DownloadCancelReceiver"
            android:exported="false" />
        <!-- Download now, on the notification of a queue that waits for Wi-Fi. -->
        <receiver
            android:name=".job.DownloadNowReceiver"
            android:exported="false" />
    </application>
</manifest>
